# Cegah file di folder ini dijalankan sebagai skrip
<FilesMatch "\.(php|phtml|phar)$">
    Require all denied
</FilesMatch>

# Semua permintaan foto lewat pemeriksa: foto barber nonaktif -> 404 untuk publik.
# Alamat foto di frontend tidak berubah (uploads/barber/<nama>.jpg|png).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^([a-f0-9]{32}\.(jpg|png))$ /KELOMPOK-5/api/barber/foto_file.php?f=$1 [L,QSA]
</IfModule>